# Anthropic API key (required for cover letter generation)
ANTHROPIC_API_KEY=your_key_here

# OpenRouter API key (alternative to Anthropic — for Kimi 2.5 and other models)
OPENROUTER_API_KEY=your_key_here

# Adzuna API credentials (free at developer.adzuna.com)
ADZUNA_APP_ID=your_app_id
ADZUNA_API_KEY=your_api_key

# Reed.co.uk API key (free at reed.co.uk/developers)
REED_API_KEY=your_api_key

# Foorilla — two options (only one needed):
# Option A: API key from foorilla.com/account/ (paid)
FOORILLA_API_KEY=your_api_key
# Option B: session cookie from browser (free account sufficient)
#   1. Log in at foorilla.com
#   2. DevTools → Application → Cookies → copy value of 'sessionid'
FOORILLA_SESSION=your_sessionid_cookie

# Serper.dev — Google search API (2,500 free searches on signup — serper.dev)
SERPER_API_KEY=your_api_key

# SQLite database path (defaults to jobpilot.db in this directory)
# DB_PATH=/custom/path/to/jobpilot.db
